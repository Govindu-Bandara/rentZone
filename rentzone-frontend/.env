# ====================
# API Configuration
# ====================
VITE_API_BASE_URL=https://z99qed07b8.execute-api.ap-southeast-2.amazonaws.com/production

# WebSocket Configuration (for real-time messaging)
VITE_WS_URL=wss://65omuffdwa.execute-api.ap-southeast-2.amazonaws.com/production/

# ====================
# Application Settings
# ====================
# App environment mode
VITE_APP_ENV=production

# App name
VITE_APP_NAME=RentZone

# ====================
# Authentication
# ====================
# Token expiry times (in seconds)
VITE_ACCESS_TOKEN_EXPIRY=3600
VITE_REFRESH_TOKEN_EXPIRY=604800

# ====================
# Feature Flags
# ====================
# Enable/disable features
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_RECOMMENDATIONS=true

# ====================
# Pagination & Limits
# ====================
VITE_DEFAULT_PAGE_SIZE=12
VITE_MAX_FILE_SIZE=5242880

# ====================
# External Services (if used)
# ====================
# Add your Google Maps API key if maps are integrated
# VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Add payment gateway keys (Stripe/Razorpay) if needed
# VITE_STRIPE_PUBLIC_KEY=your_key_here
# VITE_RAZORPAY_KEY_ID=your_key_here

# ====================
# Development Override
# ====================
# Example for local development (uncomment if running backend locally):
# VITE_API_BASE_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:3000
# VITE_APP_ENV=development